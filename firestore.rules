rules_version = '2';

// ============================================================
// REGLAS DE FIRESTORE — Joyerías del Cesar
//
// Modelo de permisos:
//   - admin:       puede leer y escribir todo (incluida la gestión de usuarios).
//   - colaborador: puede leer todo, y crear/editar (pero nunca borrar) en los
//                  módulos donde esté habilitado (hoy: reparaciones).
//   - operaciones: puede leer todo, pero NO puede escribir/editar/borrar nada.
//
// El rol vive en un "custom claim" del token de Firebase Auth (request.auth.token.role),
// NO en un campo editable por el propio usuario en Firestore. Los custom claims solo
// se asignan desde el servidor (Firebase Admin SDK, ver src/app/api/users), así que un
// usuario no puede promoverse a sí mismo a admin manipulando datos desde el cliente.
// ============================================================

function isSignedIn() {
  return request.auth != null;
}

function isAdmin() {
  return isSignedIn() && request.auth.token.role == 'admin';
}

// Puede crear y editar en los módulos habilitados para este rol, pero nunca
// eliminar — eso siempre queda exclusivo del admin.
function isColaborador() {
  return isSignedIn() && request.auth.token.role == 'colaborador';
}

service cloud.firestore {
  match /databases/{database}/documents {

    // Perfil espejo del usuario (nombre, email, rol de solo-lectura para la UI).
    // El campo "role" aquí es solo informativo para mostrar en pantalla; la
    // autorización real siempre depende del custom claim, no de este documento.
    match /users/{uid} {
      allow read: if isSignedIn() && (request.auth.uid == uid || isAdmin());
      allow write: if isAdmin();
    }

    // Datos financieros mensuales por sucursal (lo que antes venía del Excel).
    match /monthly/{docId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // Reportes de avance semanal.
    match /weekly/{docId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // Cuadres de caja diarios (uno por sucursal + fecha), que alimentan el
    // seguimiento semanal. Se guardan desde el panel de "Cuadre de caja" en
    // Editar datos, además de sumarse al mes correspondiente en /monthly.
    match /cuadres_diarios/{docId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // Registros de publicidad (incluye rutas a fotos en Storage).
    match /publicidad/{docId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // Pendientes / tareas.
    match /pendientes/{docId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // Control de reparaciones de joyas (cliente, artículo, servicio, estado, valor).
    // Un "colaborador" puede registrar y corregir reparaciones, pero borrar
    // un registro solo lo puede hacer el admin.
    match /reparaciones/{docId} {
      allow read: if isSignedIn();
      allow create, update: if isAdmin() || isColaborador();
      allow delete: if isAdmin();
    }

    // Contratos (préstamos sobre oro): ya no se guarda una fila por
    // contrato (con 100k+ filas agotaba la cuota de lecturas/escrituras de
    // Firestore solo con abrir la pantalla) — se guarda un único resumen con
    // los indicadores ya calculados al importar el informe mensual.
    match /contratos_resumen/{docId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // Colección vieja de contratos fila por fila — ya no se usa (ver
    // contratos_resumen de arriba). Se deja declarada, con lectura cerrada,
    // mientras se limpia; no bloquea nada porque el código ya no la lee.
    match /contratos/{docId} {
      allow read, write: if false;
    }

    // Facturas (R+R: retiros y renovaciones), enlazadas a un contrato por
    // Secuencia Contrato.
    match /facturas/{docId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // Inventario de joyas (una pieza por documento, id = SKU). El archivo de
    // origen es demasiado grande para subirlo desde el navegador, así que la
    // carga/actualización la hace un script de administrador — pero la
    // lectura funciona igual que las demás colecciones.
    match /inventario/{docId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // Resumen agregado del inventario (totales, conteos por sociedad/estado/
    // ciudad/categoría), calculado una sola vez al importar para no tener que
    // recorrer las 300k+ piezas cada vez que alguien abre la página.
    match /inventario_meta/{docId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // Foto e identificación por IA (tipo de producto, tejido/estilo, patrón)
    // de una pieza de inventario, por SKU. Va aparte de /inventario porque
    // ese documento se reemplaza entero cada vez que se reimporta el Excel —
    // guardar la foto ahí se perdería en la siguiente carga.
    match /inventario_fotos/{docId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // Inmuebles en arriendo de Zona Centro Inmobiliaria: un documento por
    // contrato, cargado desde el Excel maestro "BS-ACTIVOS" (propietario,
    // arrendatario, coarrendatarios, seguro y condiciones del contrato).
    match /inmuebles/{docId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // Facturas de servicios públicos (energía, acueducto, gas...) de cada
    // contrato de Zona Centro Inmobiliaria, un documento por archivo subido.
    match /facturas_servicios/{docId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // Candados de coordinación entre procesos (ej. "importLock" para que una
    // importación de contratos desde la pantalla y una desde un script de
    // servidor no corran al mismo tiempo). No son datos del negocio.
    match /meta/{docId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // Por defecto: todo lo demás queda cerrado. Cualquier colección nueva que
    // agregues debe declararse explícitamente arriba con sus propias reglas.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
