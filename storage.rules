rules_version = '2';

// ============================================================
// REGLAS DE STORAGE — fotos y PDFs de publicidad
// Mismo modelo que Firestore: cualquier usuario autenticado puede ver los
// adjuntos; solo un admin puede subir o borrar.
// ============================================================

service firebase.storage {
  match /b/{bucket}/o {

    match /publicidad/{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
                   && request.auth.token.role == 'admin'
                   && request.resource.size < 8 * 1024 * 1024   // máx. 8 MB por archivo
                   && (request.resource.contentType.matches('image/.*')
                       || request.resource.contentType == 'application/pdf');
    }

    // Fotos de piezas de inventario (para identificarlas con IA: tipo de
    // producto, tejido/estilo y patrón).
    match /inventario/{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
                   && request.auth.token.role == 'admin'
                   && request.resource.size < 8 * 1024 * 1024   // máx. 8 MB por archivo
                   && request.resource.contentType.matches('image/.*');
    }

    // Fotos de cada contrato de Zona Centro Inmobiliaria, para identificar
    // visualmente el inmueble (hasta 2 por contrato, ver base-principal).
    match /inmuebles/{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
                   && request.auth.token.role == 'admin'
                   && request.resource.size < 8 * 1024 * 1024   // máx. 8 MB por archivo
                   && request.resource.contentType.matches('image/.*');
    }

    // Facturas de servicios públicos (energía, acueducto, gas...) de cada
    // contrato de Zona Centro Inmobiliaria. La mayoría son PDF, pero
    // algunas llegan como foto (image/*) o como Word (.docx) — se acepta
    // lo mismo que el resto del panel ya acepta en otras partes.
    match /facturas_servicios/{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
                   && request.auth.token.role == 'admin'
                   && request.resource.size < 8 * 1024 * 1024   // máx. 8 MB por archivo
                   && (request.resource.contentType.matches('image/.*')
                       || request.resource.contentType == 'application/pdf'
                       || request.resource.contentType == 'application/vnd.openxmlformats-officedocument.wordprocessingml.document');
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
